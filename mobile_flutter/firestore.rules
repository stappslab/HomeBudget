rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function memberPath(householdId, userId) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(userId);
    }

    function indexPath(userId) {
      return /databases/$(database)/documents/membershipIndex/$(userId);
    }

    function isMember(householdId) {
      return verified()
        && exists(memberPath(householdId, request.auth.uid))
        && get(memberPath(householdId, request.auth.uid)).data.status == 'active';
    }

    function isOwner(householdId) {
      return isMember(householdId)
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid;
    }

    function isOwnerAfter(householdId) {
      return verified()
        && getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid
        && getAfter(memberPath(householdId, request.auth.uid)).data.status == 'active';
    }

    function validMoneyFields(data) {
      return data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 1000000000
        && ((data.baseAmountCents == null && data.rateToBaseMicros == null)
          || (data.baseAmountCents is int && data.baseAmountCents > 0
            && data.baseAmountCents <= 1000000000
            && data.rateToBaseMicros is int && data.rateToBaseMicros > 0
            && data.rateToBaseMicros <= 1000000000
            && data.baseAmountCents * 1000000 <= data.amountCents * data.rateToBaseMicros + 500000
            && data.baseAmountCents * 1000000 > data.amountCents * data.rateToBaseMicros - 500000));
    }

    match /users/{userId} {
      allow get: if verified() && request.auth.uid == userId;
      allow create: if verified() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.email;
      allow update: if verified() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }

    match /membershipIndex/{userId} {
      allow get: if verified() && request.auth.uid == userId;
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid', 'householdId'])
        && request.resource.data.uid == userId
        && isOwnerAfter(request.resource.data.householdId)
        && getAfter(memberPath(request.resource.data.householdId, userId)).data.status == 'active';
      allow update: if false;
      allow delete: if verified()
        && resource.data.uid == userId
        && !existsAfter(memberPath(resource.data.householdId, userId))
        && (request.auth.uid == userId || isOwner(resource.data.householdId));
    }

    match /households/{householdId} {
      allow get: if isMember(householdId);
      allow list: if false;
      allow create: if verified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.baseCurrency is string
        && existsAfter(memberPath(householdId, request.auth.uid));
      allow update: if isOwner(householdId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'baseCurrency', 'updatedAt'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'updatedAt'])
            && request.resource.data.ownerId != request.auth.uid
            && exists(indexPath(request.resource.data.ownerId))
            && get(memberPath(householdId, request.resource.data.ownerId)).data.status == 'active'
            && getAfter(memberPath(householdId, request.resource.data.ownerId)).data.role == 'owner'
            && getAfter(memberPath(householdId, request.auth.uid)).data.role == 'member'));
      allow delete: if false;

      match /members/{userId} {
        allow get: if isMember(householdId);
        allow list: if isMember(householdId);
        // The creator writes their own owner record together with the household.
        allow create: if (verified() && userId == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
          && getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid)
          || (isOwner(householdId)
          && request.resource.data.uid == userId
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'active'
          && exists(/databases/$(database)/documents/households/$(householdId)/joinRequests/$(userId)));
        // The owner approves a pending join request. Members cannot promote themselves.
        allow update: if isOwner(householdId)
          && ((resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.uid == userId
            && request.resource.data.role == 'member')
          || (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && ((resource.data.role == 'owner'
              && userId == request.auth.uid
              && request.resource.data.role == 'member'
              && getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerId != userId)
            || (resource.data.role == 'member'
              && request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/households/$(householdId)).data.ownerId == userId))));
        allow delete: if resource.data.role != 'owner'
          && !existsAfter(indexPath(userId))
          && (isOwner(householdId) || (verified() && userId == request.auth.uid));
      }

      match /joinRequests/{userId} {
        allow get, list: if isOwner(householdId) || (verified() && userId == request.auth.uid);
        allow create: if verified() && userId == request.auth.uid
          && !exists(indexPath(userId))
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'inviteCode', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == householdId
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.redeemedBy == request.auth.uid;
        allow delete: if isOwner(householdId) || (verified() && userId == request.auth.uid);
        allow update: if false;
      }

      match /categories/{categoryId} {
        allow read: if isMember(householdId);
        allow create: if isOwnerAfter(householdId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.archived is bool;
        allow update: if isOwner(householdId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'archived'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.archived is bool;
        allow delete: if false;
      }

      match /budgets/{budgetId} {
        allow read: if isMember(householdId);
        allow create, update: if isOwner(householdId)
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents >= 0
          && request.resource.data.currency is string;
        allow delete: if isOwner(householdId);
      }

      match /settings/{settingId} {
        allow read: if isMember(householdId);
        allow create: if isOwnerAfter(householdId);
        allow update: if isOwner(householdId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.categoryId is string
          && request.resource.data.currency is string
          && request.resource.data.isShared is bool
          && request.resource.data.expenseDate is timestamp
          && validMoneyFields(request.resource.data);
        allow update: if isMember(householdId)
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && validMoneyFields(request.resource.data);
        allow delete: if isMember(householdId) && resource.data.authorId == request.auth.uid;
      }
    }

    match /{path=**}/members/{userId} {
      allow list: if verified() && resource.data.uid == request.auth.uid;
    }

    match /invites/{code} {
      // Direct reads by a known code are allowed; queries and household data are not.
      allow get: if verified() && resource.data.expiresAt > request.time && resource.data.redeemedBy == null;
      allow list: if false;
      allow create: if isOwner(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'createdAt', 'expiresAt', 'redeemedBy', 'redeemedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.redeemedBy == null;
      // A verified user can consume a code only as part of the join transaction.
      allow update: if verified()
        && resource.data.redeemedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt'])
        && request.resource.data.redeemedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/joinRequests/$(request.auth.uid));
      allow delete: if isOwner(resource.data.householdId);
    }
  }
}
